{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-studio.dev/schemas/skill-manifest/0.1.json",
  "title": "Resume Studio Skill Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skill",
    "classification",
    "compatibility",
    "contract",
    "permissions",
    "runtime",
    "adapter",
    "security",
    "tests"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "skill": { "$ref": "#/$defs/skill" },
    "classification": { "$ref": "#/$defs/classification" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "contract": { "$ref": "#/$defs/contract" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "adapter": { "$ref": "#/$defs/adapter" },
    "security": { "$ref": "#/$defs/security" },
    "tests": { "$ref": "#/$defs/tests" },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,62}[a-z0-9]$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "$ref": "#/$defs/semver" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "uri", "revision", "contentHash", "license"],
          "properties": {
            "type": { "enum": ["BUNDLED", "GITHUB", "LOCAL", "MARKETPLACE"] },
            "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
            "contentHash": { "$ref": "#/$defs/sha256" },
            "license": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capabilities"],
      "properties": {
        "kind": {
          "enum": [
            "RESUME_REWRITE",
            "RESUME_REVIEW",
            "JOB_ANALYSIS",
            "INTERVIEW_PREP",
            "APPLICATION_OPERATIONS",
            "EVIDENCE_AUDIT",
            "OTHER"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "BLOCK_LEVEL_CHANGES",
              "JD_MATCHING",
              "STAR_REWRITE",
              "ATS_REWRITE",
              "STRUCTURE_REORDER",
              "TECHNICAL_DEPTH",
              "DESIGN_NARRATIVE",
              "FACT_AUDIT",
              "INTERVIEW_QUESTIONS",
              "APPLICATION_TRACKING"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["CODEX", "CLAUDE_CODE", "WORKBUDDY", "STANDALONE", "OTHER"] },
        "minVersion": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "operatingSystems", "dependencies"],
      "properties": {
        "hosts": {
          "type": "array",
          "items": { "$ref": "#/$defs/host" },
          "minItems": 1
        },
        "operatingSystems": {
          "type": "array",
          "items": { "enum": ["WINDOWS", "MACOS", "LINUX"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestVersions", "resumeAstVersions", "jobAstVersions", "outputMode", "changeSetVersions"],
      "properties": {
        "requestVersions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 },
          "minItems": 1,
          "uniqueItems": true
        },
        "resumeAstVersions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 },
          "minItems": 1,
          "uniqueItems": true
        },
        "jobAstVersions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 },
          "minItems": 1,
          "uniqueItems": true
        },
        "outputMode": { "enum": ["NATIVE", "ADAPTED", "ADVISORY_ONLY"] },
        "changeSetVersions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 },
          "uniqueItems": true
        }
      }
    },
    "pathPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "scopes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "networkPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "domains"],
      "properties": {
        "enabled": { "type": "boolean" },
        "domains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 253 },
          "uniqueItems": true
        },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "shellPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "commands"],
      "properties": {
        "enabled": { "type": "boolean" },
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        },
        "reason": { "type": "string", "maxLength": 1000 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileRead", "fileWrite", "network", "shell", "secrets"],
      "properties": {
        "fileRead": { "$ref": "#/$defs/pathPermission" },
        "fileWrite": { "$ref": "#/$defs/pathPermission" },
        "network": { "$ref": "#/$defs/networkPermission" },
        "shell": { "$ref": "#/$defs/shellPermission" },
        "secrets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timeoutSeconds", "supportsCancellation"],
      "properties": {
        "mode": { "enum": ["HOST_SKILL", "SUBPROCESS", "PROMPT_ONLY"] },
        "entrypoint": { "type": "string", "minLength": 1, "maxLength": 512 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "supportsCancellation": { "type": "boolean" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "normalizationMode"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "normalizationMode": { "enum": ["NONE", "STRUCTURED_MAPPING", "ADVISORY"] }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewStatus", "reviewer", "contentHash"],
      "properties": {
        "reviewStatus": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractFixtures", "lastStatus"],
      "properties": {
        "contractFixtures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "minItems": 1,
          "uniqueItems": true
        },
        "lastStatus": { "enum": ["NOT_RUN", "PASS", "FAIL"] },
        "lastRunAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}

