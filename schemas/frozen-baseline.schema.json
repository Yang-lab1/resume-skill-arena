{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-studio.dev/schemas/frozen-baseline/0.1.json",
  "title": "Resume Studio Frozen Baseline v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineId",
    "runId",
    "createdAt",
    "constraints",
    "resumeAst",
    "jobSnapshot",
    "factSnapshot"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "baselineId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "constraints": { "$ref": "#/$defs/constraints" },
    "resumeAst": { "$ref": "#/$defs/resumeAst" },
    "jobSnapshot": { "$ref": "#/$defs/jobSnapshot" },
    "factSnapshot": { "$ref": "#/$defs/factSnapshot" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalName", "mediaType", "sizeBytes", "sha256"],
      "properties": {
        "originalName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mediaType": {
          "enum": [
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/pdf",
            "image/png",
            "image/jpeg",
            "text/plain",
            "text/markdown"
          ]
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 20971520 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId",
        "index",
        "kind",
        "structuralPath",
        "contentHash",
        "text"
      ],
      "properties": {
        "blockId": { "$ref": "#/$defs/id" },
        "index": { "type": "integer", "minimum": 0, "maximum": 1999 },
        "kind": { "enum": ["PARAGRAPH", "JOB_LINE"] },
        "structuralPath": { "type": "string", "minLength": 1, "maxLength": 512 },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "styleName": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "maxPages"],
      "properties": {
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 10 },
        "templateId": { "$ref": "#/$defs/id" }
      }
    },
    "resumeAst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "resumeId",
        "resumeHash",
        "astVersion",
        "locale",
        "source",
        "blocks"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "resumeId": { "$ref": "#/$defs/id" },
        "resumeHash": { "$ref": "#/$defs/sha256" },
        "astVersion": { "const": "0.1" },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
        "source": { "$ref": "#/$defs/source" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "jobSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "jobHash",
        "astVersion",
        "locale",
        "source",
        "blocks"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "jobId": { "$ref": "#/$defs/id" },
        "jobHash": { "$ref": "#/$defs/sha256" },
        "astVersion": { "const": "0.1" },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
        "source": { "$ref": "#/$defs/source" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "evidenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceBlockId",
        "sourceRef",
        "quote",
        "lockStatus"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "sourceBlockId": { "$ref": "#/$defs/id" },
        "sourceRef": { "type": "string", "minLength": 1, "maxLength": 512 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "lockStatus": { "const": "LOCKED" }
      }
    },
    "factSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "factSnapshotId",
        "resumeId",
        "resumeHash",
        "evidenceUnits"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "factSnapshotId": { "$ref": "#/$defs/id" },
        "resumeId": { "$ref": "#/$defs/id" },
        "resumeHash": { "$ref": "#/$defs/sha256" },
        "evidenceUnits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/evidenceUnit" }
        }
      }
    }
  }
}
